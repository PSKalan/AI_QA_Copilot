{
  "name": "ai-qa-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Inspect a web app with Playwright, ingest existing test cases, retrieve context with RAG, generate and validate new test cases with a local LLM, and export to CSV.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "rag",
    "llm",
    "ollama",
    "mcp"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
