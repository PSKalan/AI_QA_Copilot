# AI QA Copilot - environment template
# Copy this file to `.env` and fill in values locally. Do not commit real values.

# Ollama (local LLM runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Embedding model is not installed yet; select and verify one locally before RAG.
OLLAMA_EMBED_MODEL=

# n8n (workflow orchestration)
N8N_BASE_URL=http://localhost:5678

# Demo website targeted by the browser inspection step
DEMO_SITE_URL=https://example.com
